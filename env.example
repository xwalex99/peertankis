# WebSocket Server config
HOST=0.0.0.0
PORT=8080
WS_PATH=/ws
NODE_ENV=production
# Orígenes permitidos para WebSocket (lista separada por comas). Producción: tankisbattle.app
ALLOWED_ORIGINS=https://tankisbattle.app,https://tankis.com,https://www.tankis.com,http://localhost:3000
MAX_ROOM_PLAYERS=10
ROOM_IDLE_TTL_MS=60000
MESSAGE_MAX_BYTES=65536
RATE_LIMIT_PER_SEC=50
PUBLIC_ROOMS_JSON={"DEATHMATCH":["DM-1","DM-2"],"TEAM_DEATHMATCH":["TDM-1"]}
HEALTH_ENABLED=true
