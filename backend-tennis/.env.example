WS_PATH=/ws
NET_TICK_RATE=60
NET_SNAPSHOT_RATE=20
NET_INPUT_RATE=30
ROOM_CODE_LENGTH=6
ROOM_IDLE_CLOSE_SEC=300
READY_TIMEOUT_SEC=90
RECONNECT_GRACE_SEC=20
MAX_PLAYERS_PER_ROOM=2
MATCH_FORMAT=BEST_OF_3_SETS
TIEBREAK_POINTS=7
ABILITY_ENABLED=true
ABILITY_STACKING=false
MAX_PING_MS_WARN=160
MAX_PING_MS_KICK=450
ANTI_CHEAT_INPUT_DELTA_MAX=1.0
SERVER_AUTHORITATIVE=true
BACKEND_VERSION=1.0.0
HOST=0.0.0.0
PORT=8080
